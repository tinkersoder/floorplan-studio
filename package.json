{
  "name": "floorplan-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone browser-based Floorplan Studio for Home Assistant",
  "author": "Tinker Söder",
  "license": "MIT",
  "homepage": "https://github.com/tinkersoder/floorplan-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkersoder/floorplan-studio.git"
  },
  "bugs": {
    "url": "https://github.com/tinkersoder/floorplan-studio/issues"
  },
  "keywords": [
    "home-assistant",
    "floorplan",
    "ha-floorplan",
    "picture-elements",
    "dashboard",
    "svg",
    "lovelace"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hacs": "tsc --noEmit && vite build --config vite.hacs.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "home-assistant-js-websocket": "^9.4.0",
    "idb": "^8.0.0",
    "immer": "^10.1.1",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
